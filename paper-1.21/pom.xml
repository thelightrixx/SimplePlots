<?xml version="1.0" encoding="utf-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>de.lightrixx</groupId>
    <artifactId>simpleplots-parent</artifactId>
    <version>v0.10.1</version>
  </parent>
  <artifactId>simpleplots-paper-1.21</artifactId>
  <name>SimplePlots (Paper 1.21)</name>
  <dependencies>
    <dependency>
      <groupId>de.lightrixx</groupId>
      <artifactId>simpleplots-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>${paper.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.2</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
    </dependency>
  </dependencies>
  <build>
    <finalName>SimplePlots-${project.version}-paper-1.21</finalName>
    <resources>
      <resource>
        <directory>${project.basedir}/..</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
        </includes>
      </resource>
      <resource>
        <directory>../paper/src/main/resources</directory>
        <excludes>
          <exclude>plugin.yml</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>../paper/src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>plugin.yml</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <artifactSet>
                <includes>
                  <include>de.lightrixx:simpleplots-common</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>de.lightrixx:simpleplots-common</artifact>
                  <excludes>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                  </excludes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>gemeinsame-paper-main</id>
            <phase>generate-sources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.sourceDirectory}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../paper/src/main/java</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>**/*.java</include>
                  </includes>
                  <excludes>
                    <exclude>de/lightrixx/plot/paper/PaperPlattform.java</exclude>
                  </excludes>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/main/java</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>**/*.java</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
          <execution>
            <id>gemeinsame-paper-test</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.testSourceDirectory}</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../paper/src/test/java</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>**/*.java</include>
                  </includes>
                  <excludes>
                    <exclude>de/lightrixx/plot/paper/listener/PlotBauListenerTest.java</exclude>
                  </excludes>
                </resource>
                <resource>
                  <directory>${project.basedir}/src/test/java</directory>
                  <filtering>false</filtering>
                  <includes>
                    <include>**/*.java</include>
                  </includes>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <sourceDirectory>${project.build.directory}/generated-sources/paper</sourceDirectory>
    <testSourceDirectory>${project.build.directory}/generated-test-sources/paper</testSourceDirectory>
  </build>
  <properties>
    <paper.version>${paper.legacy.version}</paper.version>
    <api.version>1.21.8</api.version>
    <jar.suffix>paper-1.21</jar.suffix>
  </properties>
</project>
